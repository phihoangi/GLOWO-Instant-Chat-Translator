# DEV local — sao chép thành .env.local (git-ignored). Chỉ dữ liệu tổng hợp.
DATA_MODE=synthetic

# mock = dữ liệu tổng hợp trong bộ nhớ, không cần DB (ADR-0006) | real = backend thật (M0-09+, cần DATABASE_URL)
SERVICE_MODE=mock
# Vai người dùng giả lập: recruiter | recruiter2 | admin
MOCK_USER=recruiter
# Độ trễ giả lập (ms) để thấy trạng thái loading
MOCK_LATENCY_MS=150

# Postgres dev từ `pnpm db:up` (deploy/docker-compose.dev.yml) — mật khẩu chỉ dùng cho dev local
DATABASE_URL=postgres://app:app_dev_only@localhost:54329/sourcing_dev

# BE-03 (Q-46, tạm — chờ chủ dự án xác nhận): role "owner" chạy migration/GRANT, dùng user
# bootstrap `app` ở dev. Role runtime `app_runtime` không có mật khẩu trong migration; đặt bằng
# `scripts/db/setup-roles.mjs` đọc APP_RUNTIME_DB_PASSWORD. Giá trị dưới đây CHỈ dev-only.
DATABASE_OWNER_URL=postgres://app:app_dev_only@localhost:54329/sourcing_dev
APP_RUNTIME_DB_PASSWORD=app_runtime_dev_only

# BE-05 (ADR-0005 §1): khóa ký session/cookie của Better Auth — CHỈ bắt buộc khi SERVICE_MODE=real.
# Giá trị dưới đây CHỈ dev-only, KHÔNG dùng ở production. Sinh khóa thật bằng `openssl rand -base64 32`.
BETTER_AUTH_SECRET=change-me-dev-only-not-a-real-secret-32chars

# BE-05: tạo admin ĐẦU TIÊN bằng `node scripts/seed-synthetic.ts` (Better Auth tắt đăng ký công
# khai). ADMIN_PASSWORD dưới đây CHỈ LÀ PLACEHOLDER — KHÔNG PHẢI mật khẩu thật, phải đổi trước khi
# chạy seed, tối thiểu 12 ký tự (khớp emailAndPassword.minPasswordLength).
ADMIN_EMAIL=admin@example.test
ADMIN_NAME=Admin R1 (dev)
ADMIN_PASSWORD=change-me-12-chars-min

# BE-06 (ADR-0003 §3): khóa mã hóa trường + HMAC định danh — CỐ Ý không nằm trong envSchema
# (src/server/config/env.ts), chỉ cần khi SERVICE_MODE=real/hybrid có domain "candidates" thật
# (candidates.get giải mã contact khi consent=granted). ĐỂ TRỐNG ở đây (không đặt giá trị mẫu —
# scripts/check-repo.sh cố ý coi MỌI giá trị khớp FIELD_ENC_KEY_V*/IDENTIFIER_HMAC_KEY_V* là nghi
# secret, kể cả placeholder). Sinh khóa DEV bằng `openssl rand -base64 32`, tự đặt vào `.env.local`.
FIELD_ENC_KEY_V1=
FIELD_ENC_KEY_ACTIVE=1
IDENTIFIER_HMAC_KEY_V1=
IDENTIFIER_HMAC_KEY_ACTIVE=1

# BE-06: SERVICE_MODE=hybrid (CHỈ non-production) — domain nào liệt kê ở đây dùng hiện thực real,
# còn lại dùng mock. Nếu có domain real thì "session" bắt buộc phải có mặt (actor thật phải đến từ
# auth thật). Ví dụ: REAL_DOMAINS=session,candidates
# REAL_DOMAINS=

# BE-08 / BE-09 (ADR-0002): Provider LLM ("fake" | "openai"). Mặc định fake trả dữ liệu mẫu cho dev/E2E.
LLM_PROVIDER=fake

# BE-13 (ADR-0004 §3, INV-3.4): hạn lưu trữ ứng viên theo trạng thái consent — đơn vị NGÀY.
# TEMP_TTL_DAYS / NOTIFIED_TTL_DAYS có mặc định 30 trong envSchema, bỏ comment để ghi đè.
# CONSENT_TTL_DAYS CỐ Ý không có mặc định trong code (hạn lưu dữ liệu ĐÃ ĐỒNG Ý là quyết định
# pháp lý, không đoán hộ): bắt buộc khi SERVICE_MODE=real/hybrid, và `requireTtlConfig()` chặn
# mọi phép tính hạn lưu nếu thiếu. Giá trị 365 dưới đây là giá trị TẠM theo Q-42 (khớp mock),
# chờ quyết định chính thức ở Q-05 — không phải giá trị pháp lý cuối cùng.
# TEMP_TTL_DAYS=30
# NOTIFIED_TTL_DAYS=30
CONSENT_TTL_DAYS=365

# P-04 (Q-91 đề xuất): trần gọi LLM của tìm nhanh mỗi người, cửa sổ trượt. Quá trần → chạy bằng
# quy tắc (degraded), không báo lỗi. Mặc định 20 lời gọi / 5 phút; bỏ comment để ghi đè.
# SEARCH_LLM_MAX_CALLS=20
# SEARCH_LLM_WINDOW_MS=300000

# Thêm ở các task sau — xem deploy/.env.example
# OPENAI_API_KEY=

# ID của Google Programmable Search Engine giới hạn trong linkedin.com/in/* (M1L, F-06)
# KHÔNG phải secret: nó đi ra trình duyệt theo thiết kế của CSE. Để trống = ẩn khối xem nhanh.
NEXT_PUBLIC_GOOGLE_CSE_CX=
