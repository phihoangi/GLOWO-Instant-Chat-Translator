{
  "manifest_version": 3,
  "name": "Chat Translator for LinkedIn & WhatsApp",
  "version": "1.1.0",
  "description": "Dịch tin nhắn LinkedIn và WhatsApp bằng OpenAI API key của bạn",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Chat Translator"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://*.linkedin.com/*",
    "https://*.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.whatsapp.com/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "content/*"],
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.whatsapp.com/*"
      ]
    }
  ]
}
